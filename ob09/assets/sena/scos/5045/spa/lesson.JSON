"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about a person\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about a thing\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about a place\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"When\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asks about a time\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "Who is at the door?"}, {"type": "example", "content": "What is on the table?"}, {"type": "example", "content": "Where do you live?"}, {"type": "example", "content": "When do you leave for work?"}]}, {"type": "background_image", "content": "engenn1le04ob09re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Visit your local sports and community centre. "}, {"type": "text", "content": "Make a list of the sports you can play there. "}, {"type": "text", "content": "Make a list of the activities you can do there. "}, {"type": "text", "content": "What activities or sports do you like? "}, {"type": "text", "content": "Compare your list with your partner's! "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about sports and activities."}, {"type": "text", "content": "I write about likes and dislikes."}, {"type": "text", "content": "I use the <span class=\"italic\">-ing</span> form to talk about what I like doing. "}]}], "type": "sena"}