}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "video game"}, {"type": "definition", "content": "a game you play on a computer or a television screen"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I love playing video games with my girlfriend."}, {"type": "audio", "content": "engenn1le04ob09aud06"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you can use to talk about hobbies, sports and activities. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "soccer"}, {"type": "definition", "content": "in North America, a game with 11 players, played with feet only"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Real Madrid is my favorite soccer team."}, {"type": "audio", "content": "engenn1le04ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "football"}, {"type": "definition", "content": "in North America, a game with 11 players, played with hands and feet"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I love watching American football on TV."}, {"type": "audio", "content": "engenn1le04ob09aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sport"}, {"type": "definition", "content": "a game you play with physical activity, alone or in a team "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: My favorite sport is football."}, {"type": "audio", "content": "engenn1le04ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to run"}, {"type": "definition", "content": "to move your legs faster than walking"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  I run around the park every day."}, {"type": "audio", "content": "engenn1le04ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "