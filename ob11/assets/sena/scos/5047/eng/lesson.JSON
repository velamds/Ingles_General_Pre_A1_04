re2img01.jpg"}, {"text": "<span class=\"strong\">Interviewer</span>:\tThat's good news for you!\n<br /><span class=\"strong\">Cynthia</span>:   \tYes, he always loves writing articles about me!", "id": 5, "time": "39500", "image": "engenn1le04ob11re2img01.jpg"}], "audiosrc": "engenn1le04ob11re2aud01", "coverimg": "engenn1le04ob11re2img01.jpg"}, "type": "slideshow"}], "_data": [{"content": [], "type": "tips"}], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": "", "type": "audio"}], "_data": [], "type": "text", "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Everyday Things", "type": "lesson_name"}, {"content": "What Time Do You ... ?", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 4, "type": "lesson"}, {"content": "Beginner", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "learning_points", "contents": [{"content": " Daily Routines", "type": "heading"}, {"content": "Routines are actions you do in order.", "type": "describer"}, {"content": "wake up ", "type": "example"}, {"content": " Your daily routines are the actions you do every day. ", "type": "text"}, {"content": "Note: You use the Simple Present tense to talk about routines.", "type": "text"}, {"content": "get up", "type": "example"}, {"content": "have breakfast/lunch/dinner", "type": "example"}, {"content": "walk", "type": "example"}, {"content": "drive", "type": "example"}, {"content": "study", "type": "example"}, {"content": "go to school/work/bed", "type": "example"}, {"content": "I wake up at 7 a.m. ", "type": "example"}, {"content": "I drive to work every morning.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Talking About Time", "type": "heading"}, {"content": "This is how you talk about time:", "type": "describer"}, {"content": "{\"rows\":\"03\",\"columns\":\"04\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Question </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Answer</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Example </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Time of the day</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> What time is it?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's \u2026 <br />It is \u2026\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> It's 7 o'clock. <br /> It is 3:30 p.m.</span>\\t \\t\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Time of daily activities</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> What time do you get up?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I get up at \u2026\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> I get up at 7:15 a.m. <br />I get up at quarter past seven.</span>\\t \\t\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "NOTE:  <br />7:15 = Quarter past seven <br />6:45 = Quarter to seven<br/><br/>", "type": "text"}, {"content": "<span class=\"strong\"> Adverbs of frequency</span> (<span class=\"italic\"> always, usually, never</span>, etc.) say how often something happens.<br/>  <br/> ", "type": "text"}, {"content": "This coffee shop is always busy.\t", "type": "example"}, {"content": "I never drink tea.", "type": "example"}, {"content": "Jane usually arrives home at 9:00 p.m.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "I'm a/an \u2026", "type": "name"}, {"content": "used to say what your job is", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm a teacher. I'm an artist.", "type": "example"}, {"content": "engenn1le04ob11aud06", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are the expressions to review.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to get up", "type": "name"}, {"content": "to leave the bed after you wake up", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I get up at 7 a.m. every day.", "type": "example"}, {"content": "engenn1le04ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "singer", "type": "name"}, {"content": "a person who sings", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He is a singer in a band.", "type": "example"}, {"content": "engenn1le04ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "late", "type": "name"}, {"content": "after a specific time", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: My bus usually leaves late, so I get to work after 10 a.m. ", "type": "example"}, {"content": "engenn1le04ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "How often \u2026 ?", "type": "name"}, {"content": "to ask how many times you do something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: How often do you take the bus?", "type": "example"}, {"content": "engenn1le04ob11aud01", "type": "audio"}]}, {"type": "objectives", "contents": [{"content": "Express information about  daily or weekly routine in a very simple way.", "type": "primary"}, {"content": "Provides simple personal information in written texts and spoken form through simple comprehensible phrases.", "type": "secondary_1"}, {"content": "Provides simple personal information in written texts and spoken form through simple comprehensible phrases.", "type"