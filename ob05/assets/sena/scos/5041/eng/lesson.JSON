s": [{"value": "{\"type\": \"skill\", \"content\": \"Reading\"}", "content": "Reading", "type": "skill", "valid": 1}]}, {"content": [{"content": "<span class=\"italic\">\"From ... to\"</span> are prepositions of time you use to talk about two points in time.", "type": "text", "tip_id": 0}], "type": "tips"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Move the times up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> according to the pictures.", "type": "text"}, {"content": "You have 2 attempts to submit your answers.", "type": "text"}]}], "type": "MT1", "template_override": 1}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Everyday Things", "type": "lesson_name"}, {"content": "What Time Does She Have Breakfast? ", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 4, "type": "lesson"}, {"content": "Beginner", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "learning_points", "contents": [{"content": "Daily Routines", "type": "heading"}, {"content": "<span class=\"strong\">Routines</span>  are things you do in order.   Your <span class=\"strong\">daily routines</span>  are the actions you do every day. ", "type": "describer"}, {"content": "Let's look at some examples.", "type": "text"}, {"content": "{\"rows\":1,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"wake up/get up <br />eat breakfast/lunch/dinner <br />walk  <br />drive <br />do <br />study <br />cook <br />watch <br />go to school/work/bed\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wake up at 6 a.m. <br />I eat lunch at noon. <br />She walks to school.  <br />He drives to work. <br />We do our homework after school. <br />He studies in the library. <br />My mom cooks dinner at 5 p.m. <br />After dinner, they watch TV. <br />You go to bed at 11 p.m. </span> \\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "Note: You use the <span class=\"strong\">Simple Present tense </span> to talk about routines.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to wake up", "type": "name"}, {"content": "to stop sleeping", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I wake up in the morning at 6 o'clock.", "type": "example"}, {"content": "engenn1le04ob05aud04", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about your daily routine.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to have breakfast", "type": "name"}, {"content": "to eat the first meal of the day", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I have breakfast at 8 o'clock.", "type": "example"}, {"content": "engenn1le04ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to walk", "type": "name"}, {"content": "to move with your legs", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I walk to school.", "type": "example"}, {"content": "engenn1le04ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to volunteer", "type": "name"}, {"content": "to do a job without getting any money", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I volunteer at the school. ", "type": "example"}, {"content": "engenn1le04ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to go to bed", "type": "name"}, {"content": "to prepare for sleep", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We go to bed in the evening. ", "type": "example"}, {"content": "engenn1le04ob05aud01", "type": "audio"}]}, {"type": "objectives", "contents": [{"content": "Express information about  daily or weekly routine in a very simple way.", "type": "primary"}, {"content": "Speaks in English about daily routines with a limited range of vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_1"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_2"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_3"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_4"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_5"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_6"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_7"}, {"content": "Completes simple dialogues by the addition or selection of appropriate language according to the communicative functions of this level. ", "type": "secondary_8"}, {"content": "Completed.", "type": "secondary_9"}]}, {"content": "engenn1le04ob05re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": " Interview your partner. Ask these questions: <ul><li>When do you wake up?</li> <li>When does your class or work start?</li> <li>When do you eat lunch?</li> <li>When do you do your homework?</li> <li>When do you go home?</li> <li>When do you go to sleep?</li></ul>", "type": "text"}, {"content": " Use your partner's answers and write complete sentences. Look at the dialogue again for help.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I ask about my partner's daily routine.", "type": "text"}, {"content": "I talk about daily activities.", "type": "text"}, {"content": "I say times of the day.", "type": "text"}]}], "type": "sena"}